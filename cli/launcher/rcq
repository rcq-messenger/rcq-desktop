#!/usr/bin/env bash
# Thin launcher so nobody types `node .../rcq.mjs` per command. Ship it beside
# rcq.mjs; `ln -s` it anywhere on PATH and `rcq` just works.
# BASH_SOURCE names the SYMLINK when invoked through one, and rcq.mjs does not
# live next to the symlink -- walk the link chain to the real file first.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
exec node "$(cd "$(dirname "$src")" && pwd)/rcq.mjs" "$@"
