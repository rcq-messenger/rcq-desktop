{
  // Type-check only — esbuild does the emit and strips types unchecked, so
  // this is the net that catches what the bundler will not. NOT in the app's
  // tsconfig `include`: the web build must not start compiling node code.
  // Checks the cli tree plus whatever it transitively imports from src/lib
  // (against the BROWSER signalwasm .d.ts — the pkg-node build has the same
  // API surface, which is the premise the runtime alias stands on).
  // Run: npx tsc -p cli
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "shims", "test"]
}
