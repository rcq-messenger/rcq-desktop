{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RCQ",
  "version": "0.3.49",
  "identifier": "app.rcq.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost https: http: wss: ws:; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Yaroslav Tager (P29Q334JHX)",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "14.0"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/sing-box"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://dl.rcq.app/desktop/latest.json",
        "https://rcq.app/desktop/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzNjY3ODlGREZBNjkxOTIKUldTU2thYmZuM2htVThRWEhDV0RmNHF5ZmVnTURucGhDb3dtTm1CY2FRalBYOUJkdENQK1lsZHIK"
    }
  }
}
